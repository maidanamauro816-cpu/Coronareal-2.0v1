rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function self(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function admin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin';
    }

    function staff() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol in ['barbero', 'admin'];
    }

    match /users/{uid} {
      allow read: if self(uid) || admin();
      allow create: if self(uid)
        && (!('rol' in request.resource.data) || request.resource.data.rol == 'cliente')
        && (!('uid' in request.resource.data) || request.resource.data.uid == uid);
      allow update: if self(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['uid', 'nombre', 'displayName', 'name', 'email', 'fotoPerfil', 'bio', 'telefono', 'updatedAt'])
        && (!('uid' in request.resource.data) || request.resource.data.uid == uid);
      allow delete: if admin();
    }

    match /servicios/{id} {
      allow read: if true;
      allow create, update, delete: if staff();
    }

    match /reservas/{id} {
      allow create: if signedIn()
        && request.resource.data.clienteId == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.keys().hasAll(['clienteId', 'servicioNombre', 'fecha', 'horaInicio', 'estado']);
      allow read: if signedIn()
        && (resource.data.clienteId == request.auth.uid
          || (resource.data.barberoId == request.auth.uid && staff())
          || admin());
      allow update: if signedIn()
        && ((resource.data.clienteId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
            && request.resource.data.estado == 'cancelado')
          || (staff()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
            && request.resource.data.estado in ['confirmado', 'cancelado', 'completado']));
      allow delete: if admin();
    }

    match /productos/{id} {
      allow read: if true;
      allow write: if staff();
    }
  }
}