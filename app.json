{
  "expo": {
    "name": "Corona Real",
    "slug": "coronareal2-0",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "coronareal",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Corona Real necesita acceso a tus fotos para elegir una imagen de perfil.",
          "cameraPermission": "Corona Real puede usar la cámara si decidís tomar una foto."
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "googleServicesFile": "./google-services.json"
        }
      ]
    ],
    "android": {
      "package": "com.maidanamauro.coronareal2v1",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "READ_MEDIA_IMAGES"
      ]
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}